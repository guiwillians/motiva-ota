#include <WiFi.h>

const char* INSTALLED_VERSION = "2.0";
const unsigned long READ_INTERVAL_MS = 2000;
const unsigned long SESSION_INTERVAL_MS = 48000;
const int NUM_READINGS = 5;

const int LED_R = 25;
const int LED_G = 26;
const int LED_B = 27;

enum SystemState { NORMAL, ALERTA };
SystemState state = NORMAL;

int readings[NUM_READINGS];
int sortedReadings[NUM_READINGS];
int readingIndex = 0;
unsigned long sessionStart = 0;
unsigned long nextReadingAt = 0;
int sessionNumber = 0;

void setLed(bool red, bool green, bool blue) {
  digitalWrite(LED_R, red ? HIGH : LOW);
  digitalWrite(LED_G, green ? HIGH : LOW);
  digitalWrite(LED_B, blue ? HIGH : LOW);
}

void showState() {
  if (state == ALERTA) {
    setLed(true, false, false);
    Serial.println("Estado: ALERTA | LED vermelho");
  } else {
    setLed(false, true, false);
    Serial.println("Estado: NORMAL | LED verde");
  }
}

void startSession(unsigned long startTime) {
  sessionStart = startTime;
  nextReadingAt = startTime;
  readingIndex = 0;
  sessionNumber++;
  Serial.printf("\nInicio da sessao %d (t=%lu ms)\n", sessionNumber, sessionStart);
}

void sortCopy() {
  for (int i = 0; i < NUM_READINGS; i++) sortedReadings[i] = readings[i];
  for (int i = 0; i < NUM_READINGS - 1; i++) {
    for (int j = 0; j < NUM_READINGS - 1 - i; j++) {
      if (sortedReadings[j] > sortedReadings[j + 1]) {
        int temp = sortedReadings[j];
        sortedReadings[j] = sortedReadings[j + 1];
        sortedReadings[j + 1] = temp;
      }
    }
  }
}

void finishSession() {
  long sum = 0;
  for (int i = 0; i < NUM_READINGS; i++) sum += readings[i];
  sortCopy();
  int median = sortedReadings[2];

  Serial.print("Ordem original: ");
  for (int i = 0; i < NUM_READINGS; i++) {
    Serial.printf("%d%s", readings[i], i == NUM_READINGS - 1 ? "" : " ");
  }
  Serial.println(" cm");
  Serial.print("Ordem crescente: ");
  for (int i = 0; i < NUM_READINGS; i++) {
    Serial.printf("%d%s", sortedReadings[i], i == NUM_READINGS - 1 ? "" : " ");
  }
  Serial.println(" cm");
  Serial.printf("Media da sessao: %.1f cm\n", sum / (float)NUM_READINGS);
  Serial.printf("Mediana da sessao: %d cm\n", median);

  // Histerese: os limites intermediarios preservam o estado anterior.
  if (median >= 16) {
    state = ALERTA;
    Serial.println("Histerese: mediana >= 16, entrando em ALERTA.");
  } else if (median <= 14) {
    state = NORMAL;
    Serial.println("Histerese: mediana <= 14, entrando/retornando a NORMAL.");
  } else {
    Serial.println("Histerese: mediana entre 14 e 16, mantendo o estado anterior.");
  }
  showState();
  Serial.println("Proxima sessao em 48 segundos.");
}

void takeReading() {
  readings[readingIndex] = random(10, 21);
  Serial.printf("Leitura %d: %d cm\n", readingIndex + 1, readings[readingIndex]);
  readingIndex++;
  nextReadingAt += READ_INTERVAL_MS;
  if (readingIndex == NUM_READINGS) {
    finishSession();
    sessionStart += SESSION_INTERVAL_MS;
    nextReadingAt = sessionStart;
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(LED_R, OUTPUT);
  pinMode(LED_G, OUTPUT);
  pinMode(LED_B, OUTPUT);
  randomSeed(micros());
  Serial.println("========================================");
  Serial.println("MONITORAMENTO DE VEGETACAO - FW 2.0");
  Serial.println("========================================");
  Serial.println("Firmware 2.0 obtido via atualizacao OTA");
  state = NORMAL;
  showState();
  startSession(millis());
}

void loop() {
  unsigned long now = millis();
  if (readingIndex < NUM_READINGS && (long)(now - nextReadingAt) >= 0) {
    takeReading();
  }
  if (readingIndex == NUM_READINGS && (long)(now - sessionStart) >= 0) {
    startSession(sessionStart);
  }
  delay(5);
}
